/* Roulette's initial tile sample is an interior element of sSinCosTable.
 * Indexing the table in C adds address arithmetic and changes the ROM, so expose
 * that existing address directly without a C-level asm symbol alias. */
sRouletteInitialTileSin = sSinCosTable + 0x1C0;
